{
  "name": "lofish-market",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "nodemon ./bin/www",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d ./config/typeorm-cli.js",
    "typeorm:create": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "migration": "npm run typeorm migration:run",
    "migration:generate": "npm run typeorm migration:generate -- --outputJs",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:create": "npm run typeorm:create migration:create  -- --outputJs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "pug": "^3.0.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.27"
  }
}
